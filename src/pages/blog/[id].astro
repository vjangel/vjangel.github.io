---
import EntryDetail from '../../components/EntryDetail.astro';
import { getLocalizedPaths, type LocalizedEntry } from '../../lib/content';

export function getStaticPaths() {
  return getLocalizedPaths('posts', 'zh-CN');
}

interface Props {
  item: LocalizedEntry<'posts'>;
}
---

<EntryDetail locale="zh-CN" item={Astro.props.item} />
