---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocalizedCollection } from '../lib/content';
import { copy, localizedPath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const title = copy[locale].blog;
const description = locale === 'en' ? 'Notes by VeiJay.' : 'VeiJay 的技术笔记。';
const posts = await getLocalizedCollection('posts', locale);
const formatDate = new Intl.DateTimeFormat(locale, { dateStyle: 'medium', timeZone: 'UTC' });
---

<BaseLayout {locale} {title} {description} path="/blog/" active="blog">
  <section class="shell">
    <header class="page-intro">
      <h1 class="section-title">{title}</h1>
    </header>
    <div class="post-list">
      {posts.map(({ slug, entry: { data }, language }) => (
        <a class="post-row" href={localizedPath(locale, `/blog/${slug}/`)}>
          <div lang={language}>
            <h2>{data.title}</h2>
            <p>{data.description}</p>
          </div>
          <time datetime={data.date.toISOString().slice(0, 10)}>{formatDate.format(data.date)}</time>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
